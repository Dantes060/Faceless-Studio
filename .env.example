# ---------------------------------------------------------------------------
# Faceless Studio — copy to .env and fill in what you have.
# With no keys at all it runs in mock mode: every stage works, assets are
# placeholders, and nothing is billed.
# ---------------------------------------------------------------------------

# auto  = live for any provider whose key is present (default)
# mock  = never call a paid API
# live  = require real keys, fail loudly if missing
PROVIDER_MODE=auto

# --- text / script generation ---------------------------------------------
# "openai" | "deepseek" | "custom" (any OpenAI-compatible endpoint)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cheaper bulk script generation:
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# --- images ---------------------------------------------------------------
# Uses OPENAI_API_KEY. gpt-image-1 sizes: 1024x1536 (9:16), 1536x1024 (16:9)
IMAGE_MODEL=gpt-image-1

# --- video (Kling AI, official API) ---------------------------------------
# Console: https://app.klingai.com  -> API keys are an access/secret pair.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_MODEL=kling-v1-6
# std = cheaper/faster, pro = better motion
KLING_MODE=std

# --- narration ------------------------------------------------------------
# openai (default) | voicestudio | custom | mock
# "openai" and "voicestudio" both use POST /v1/audio/speech, so switching is
# just a different base URL + model. VoiceStudio is self-hosted: see README.
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Any OpenAI-compatible TTS endpoint (overrides the OpenAI default):
TTS_BASE_URL=
TTS_API_KEY=

# --- VoiceStudio (only used when TTS_PROVIDER=voicestudio) ----------------
# Point at your running VoiceStudio instance (default port 3900).
VOICESTUDIO_URL=http://127.0.0.1:3900
VOICESTUDIO_API_KEY=
# omnivoice (default engine) | voxcpm2 | cosyvoice | kittentts | ...
VOICESTUDIO_MODEL=omnivoice
# Voice profile id/name from the VoiceStudio app, or an OpenAI voice alias.
VOICESTUDIO_VOICE=default

# --- assembly -------------------------------------------------------------
# Path to ffmpeg if it is not on PATH. Without it, the app exports a
# storyboard HTML + shotlist instead of an mp4.
FFMPEG_PATH=

# --- product settings -----------------------------------------------------
FACELESS_DATA_DIR=./data
# Encryption key for API keys stored in-app. Set it to pin the secret;
# if omitted, a random secret.key is generated in FACELESS_DATA_DIR.
APP_SECRET=
CREDIT_USD=0.05
SIGNUP_FREE_CREDITS=500
ALLOW_SIGNUP=true
MAX_SCENES=40
